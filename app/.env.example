# Local development only. On AWS every value below is injected by ECS — the DB_*
# values and SESSION_SECRET from Secrets Manager — so never put real production
# credentials in this file.
PORT=3000

# MySQL (any local MySQL 8 works)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=support_portal

# Signs the session cookie. Any long random string locally.
SESSION_SECRET=change-me-to-a-long-random-string
# Set to true only when the site is served over HTTPS
COOKIE_SECURE=false

# Cognito: use the pool Terraform created (`terraform output cognito_user_pool_id`
# and `cognito_client_id`). Your local AWS credentials need the Cognito admin
# permissions used for registration. Sign-in does not work without these.
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Optional: S3 bucket for ticket attachments (`terraform output s3_bucket_name`).
# Leave empty to disable uploads locally.
ASSETS_BUCKET=
