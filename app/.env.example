# Local development only. On AWS the DB_* values are injected by ECS from Secrets Manager.
PORT=3000
DB_HOST=your-rds-endpoint.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=changeme
DB_NAME=support_portal

# Admin view (/admin). On AWS both come from Secrets Manager (support-portal/app).
ADMIN_PASSWORD=choose-a-local-password
SESSION_SECRET=any-long-random-string
