<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Knowledge Base - Support Portal</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <%- include('partials-nav') %>
  <div class="container">
    <h1>Knowledge Base</h1>

    <% if (user.role !== 'customer') { %>
    <form action="/kb" method="POST" class="card-form">
      <input type="text" name="title" placeholder="Article title" required>
      <input type="text" name="category" placeholder="Category" required>
      <textarea name="body" placeholder="Article content" required></textarea>
      <button type="submit">Publish Article</button>
    </form>
    <% } %>

    <form action="/kb" method="GET" class="filter-bar">
      <input type="search" name="q" value="<%= filters.q %>" placeholder="Search title, body or category">
      <select name="category">
        <option value="">All categories</option>
        <% categories.forEach(function(c) { %>
          <option value="<%= c %>" <%= filters.category === c ? 'selected' : '' %>><%= c %></option>
        <% }) %>
      </select>
      <button type="submit">Search</button>
      <a href="/kb">Clear</a>
    </form>

    <% if (!articles.length) { %><p class="muted">No articles match.</p><% } %>
    <div class="list">
      <% articles.forEach(function(a) { %>
        <div class="card">
          <div class="card-header">
            <a href="/kb/<%= a.id %>"><strong><%= a.title %></strong></a>
            <span class="tag"><%= a.category %></span>
          </div>
          <p class="muted"><%= new Date(a.created_at).toLocaleString() %></p>
          <div class="card-actions">
            <% if (user.role !== 'customer') { %><a href="/kb/<%= a.id %>/edit">Edit</a><% } %>
            <% if (user.role === 'admin') { %>
              <form action="/kb/<%= a.id %>/delete" method="POST">
                <button type="submit">Delete</button>
              </form>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</body>
</html>
