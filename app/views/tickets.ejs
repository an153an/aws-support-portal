<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Tickets - Support Portal</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <%- include('partials-nav') %>
  <div class="container">
    <h1>Support Tickets</h1>

    <form action="/tickets" method="POST" class="card-form">
      <input type="text" name="subject" placeholder="Subject" required>
      <textarea name="description" placeholder="Describe the issue" required></textarea>
      <div class="row">
        <label>Priority
          <select name="priority">
            <% PRIORITIES.forEach(function(p) { %><option value="<%= p %>" <%= p === 'medium' ? 'selected' : '' %>><%= p %></option><% }) %>
          </select>
        </label>
        <label>Category
          <select name="category">
            <% CATEGORIES.forEach(function(c) { %><option value="<%= c %>"><%= c %></option><% }) %>
          </select>
        </label>
      </div>
      <button type="submit">Submit Ticket</button>
    </form>

    <form action="/tickets" method="GET" class="filter-bar">
      <input type="search" name="q" value="<%= filters.q %>" placeholder="Search subject or description">
      <% if (user.role !== 'customer') { %>
        <input type="search" name="requester" value="<%= filters.requester %>" placeholder="Requester">
      <% } %>
      <select name="status">
        <option value="">All statuses</option>
        <% ['open', 'in_progress', 'closed'].forEach(function(s) { %>
          <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s.replace('_', ' ') %></option>
        <% }) %>
      </select>
      <select name="priority">
        <option value="">All priorities</option>
        <% PRIORITIES.forEach(function(p) { %><option value="<%= p %>" <%= filters.priority === p ? 'selected' : '' %>><%= p %></option><% }) %>
      </select>
      <select name="category">
        <option value="">All categories</option>
        <% CATEGORIES.forEach(function(c) { %><option value="<%= c %>" <%= filters.category === c ? 'selected' : '' %>><%= c %></option><% }) %>
      </select>
      <button type="submit">Search</button>
      <a href="/tickets">Clear</a>
    </form>

    <% if (!tickets.length) { %><p class="muted">No tickets match.</p><% } %>
    <div class="list">
      <% tickets.forEach(function(t) { %>
        <div class="card">
          <div class="card-header">
            <a href="/tickets/<%= t.id %>"><strong>#<%= t.id %> <%= t.subject %></strong></a>
            <span>
              <span class="priority priority-<%= t.priority %>"><%= t.priority %></span>
              <span class="tag"><%= t.category %></span>
              <span class="status status-<%= t.status %>"><%= t.status.replace('_', ' ') %></span>
            </span>
          </div>
          <p class="muted">From <%= t.requester %> &middot; <%= new Date(t.created_at).toLocaleString() %> &middot; <%= t.assignee_name ? 'Assigned to ' + t.assignee_name : 'Unassigned' %></p>
          <p><%= t.description %></p>
          <div class="card-actions">
            <% if (user.role !== 'customer') { %>
              <form action="/tickets/<%= t.id %>/status" method="POST">
                <select name="status" onchange="this.form.submit()">
                  <option value="open" <%= t.status === 'open' ? 'selected' : '' %>>Open</option>
                  <option value="in_progress" <%= t.status === 'in_progress' ? 'selected' : '' %>>In Progress</option>
                  <option value="closed" <%= t.status === 'closed' ? 'selected' : '' %>>Closed</option>
                </select>
              </form>
              <form action="/tickets/<%= t.id %>/assign" method="POST">
                <select name="assignee" onchange="this.form.submit()">
                  <option value="">Unassigned</option>
                  <% staff.forEach(function(s) { %>
                    <option value="<%= s.sub %>" <%= t.assignee_sub === s.sub ? 'selected' : '' %>><%= s.name %></option>
                  <% }) %>
                </select>
              </form>
            <% } %>
            <% if (user.role === 'admin') { %>
              <form action="/tickets/<%= t.id %>/delete" method="POST">
                <button type="submit">Delete</button>
              </form>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</body>
</html>
