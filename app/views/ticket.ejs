<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>#<%= ticket.id %> <%= ticket.subject %> - Support Portal</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <%- include('partials-nav') %>
  <div class="container">
    <a href="/tickets">&larr; Back to tickets</a>
    <div class="card detail">
      <div class="card-header">
        <h1>#<%= ticket.id %> <%= ticket.subject %></h1>
        <span>
          <span class="priority priority-<%= ticket.priority %>"><%= ticket.priority %></span>
          <span class="tag"><%= ticket.category %></span>
          <span class="status status-<%= ticket.status %>"><%= ticket.status.replace('_', ' ') %></span>
        </span>
      </div>
      <p class="muted">From <%= ticket.requester %> &middot; opened <%= new Date(ticket.created_at).toLocaleString() %> &middot; <%= ticket.assignee_name ? 'Assigned to ' + ticket.assignee_name : 'Unassigned' %><% if (ticket.closed_at) { %> &middot; closed <%= new Date(ticket.closed_at).toLocaleString() %><% } %></p>
      <div class="article-body"><%= ticket.description %></div>

      <% if (ticket.updated_at) { %><p class="muted">Last edited <%= new Date(ticket.updated_at).toLocaleString() %></p><% } %>
      <% if (canEdit) { %><p><a href="/tickets/<%= ticket.id %>/edit">Edit ticket</a></p><% } %>

      <% if (user.role !== 'customer') { %>
        <div class="card-actions">
          <form action="/tickets/<%= ticket.id %>/status" method="POST">
            <input type="hidden" name="back" value="detail">
            <select name="status" onchange="this.form.submit()">
              <% ['open', 'in_progress', 'closed'].forEach(function(s) { %>
                <option value="<%= s %>" <%= ticket.status === s ? 'selected' : '' %>><%= s.replace('_', ' ') %></option>
              <% }) %>
            </select>
          </form>
          <form action="/tickets/<%= ticket.id %>/assign" method="POST">
            <input type="hidden" name="back" value="detail">
            <select name="assignee" onchange="this.form.submit()">
              <option value="">Unassigned</option>
              <% staff.forEach(function(s) { %>
                <option value="<%= s.sub %>" <%= ticket.assignee_sub === s.sub ? 'selected' : '' %>><%= s.name %></option>
              <% }) %>
            </select>
          </form>
        </div>
      <% } %>
    </div>

    <h2 id="attachments">Attachments (<%= attachments.length %>)</h2>
    <% if (!attachments.length) { %><p class="muted">No files attached.</p><% } %>
    <% attachments.forEach(function(f) { %>
      <div class="card attachment">
        <a href="/tickets/<%= ticket.id %>/attachments/<%= f.id %>"><%= f.filename %></a>
        <span class="muted"><%= formatBytes(Number(f.size_bytes)) %> &middot; <%= f.uploaded_by_name %> &middot; <%= new Date(f.created_at).toLocaleString() %></span>
        <% if (user.role !== 'customer' || f.uploaded_by_sub === user.sub) { %>
          <form action="/tickets/<%= ticket.id %>/attachments/<%= f.id %>/delete" method="POST" onsubmit="return confirm('Remove <%= f.filename.replace(/'/g, '') %>?')">
            <button type="submit">Remove</button>
          </form>
        <% } %>
      </div>
    <% }) %>
    <% if (uploadsEnabled) { %>
      <form action="/tickets/<%= ticket.id %>/attachments" method="POST" enctype="multipart/form-data" class="card-form">
        <input type="file" name="file" required>
        <p class="muted">Up to <%= maxMb %> MB: images, PDF, text/log/CSV/JSON, Office documents, ZIP.</p>
        <button type="submit">Attach file</button>
      </form>
    <% } else { %>
      <p class="muted">File uploads are unavailable (no storage bucket configured).</p>
    <% } %>

    <h2 id="comments">Comments (<%= commentCount %>)</h2>
    <% if (!thread.length) { %><p class="muted">No comments yet.</p><% } %>
    <% thread.forEach(function(c) { %>
      <%- include('comment', { comment: c, ticketId: ticket.id }) %>
    <% }) %>
    <form action="/tickets/<%= ticket.id %>/comments" method="POST" class="card-form">
      <textarea name="body" placeholder="Add a comment" required></textarea>
      <button type="submit">Comment</button>
    </form>

    <h2>History</h2>
    <ul class="history">
      <li><span class="muted"><%= new Date(ticket.created_at).toLocaleString() %></span> Ticket opened by <%= ticket.requester %></li>
      <% history.forEach(function(h) { %>
        <li>
          <span class="muted"><%= new Date(h.created_at).toLocaleString() %></span>
          <%= h.actor_name %> changed <strong><%= h.field %></strong>
          from <em><%= h.old_value || 'none' %></em> to <em><%= h.new_value || 'none' %></em>
        </li>
      <% }) %>
    </ul>
  </div>
</body>
</html>
